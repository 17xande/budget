# Copy to .env (never committed). Every variable is optional unless marked.

# REQUIRED for compose: the hostname Traefik routes to this app.
BUDGET_HOST=budget.example.com

# Where the SQLite database lives. The image sets /data/budget.db (a named volume).
# DB_PATH=data/budget.db

# Session cookies are Secure (https only) unless this is false. Set false ONLY
# for plain-http local development (`make run` sets it for you).
# COOKIE_SECURE=true

# How long a sign-in lasts. A password change ends every session regardless.
# SESSION_TTL=720h

# CIDRs of proxies allowed to set X-Forwarded-For / CF-Connecting-IP. Behind
# Traefik on a Docker network, that network's range. Empty trusts nothing, so
# every request shares the proxy's address for rate limiting: safe, just coarse.
TRUSTED_PROXIES=172.16.0.0/12

# One-time token for claiming the first account at /setup. Leave unset and one is
# generated and printed in the log on first start (docker compose logs budget).
# If set, at least 32 characters: openssl rand -base64 32
# SETUP_TOKEN=

# --- Daily FNB fetch (optional; without FNB_USERNAME it is off) ----------------
# The online banking username. The password goes in ./secrets/fnb_password (one
# line, chmod 600), which compose mounts as a docker secret; a plain FNB_PASSWORD
# variable is refused.
# FNB_USERNAME=
# If your login has several profiles (personal and business, say), the exact name
# of the one to use, as FNB's "Linked Profiles" page shows it.
# FNB_PROFILE=
# Daily run time, South African time.
# FETCH_AT=06:00
# FNB product codes to fetch: DDA cheque, ZFN credit card (TOA savings, MLS loan).
# FNB_PRODUCTS=DDA,ZFN
